# ──────────────────────────────────────────────────────────────────────────────
# Environment files — NEVER commit. Anything not matching the example pattern
# is excluded everywhere in the tree.
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.*
**/.env
**/.env.*
# Allow templates that describe required keys (no secret values).
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

