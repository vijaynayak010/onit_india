# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment template. COPY this to client/.env and fill values
# locally. NEVER commit the real .env file.
#
# Anything prefixed with VITE_ is inlined into the browser bundle at build
# time and is therefore PUBLIC. Treat it like a published value. Do not put
# server-side secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# Browser API URL — NEVER put the Lambda URL here (security: visible in Network tab).
# Dev + Vercel: same-origin proxy → Lambda (see ONIT_BACKEND_API_URL below).
VITE_API_URL=/api-onitindia
VITE_WS_URL=wss://ohh9kczx4k.execute-api.ap-south-1.amazonaws.com/prod

# Server-only: Vite dev proxy + Vercel rewrite target (NOT bundled into browser).
ONIT_BACKEND_API_URL=https://wcnwjjyw3er242onl66k4ljnei0xqykl.lambda-url.ap-south-1.on.aws

# Auth0 SPA configuration (hybrid model: separate client IDs per app)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
VITE_AUTH0_CLIENT_ID_PROVIDER=your-provider-auth0-spa-client-id
VITE_AUTH0_CLIENT_ID_TASKER=your-tasker-auth0-spa-client-id
VITE_AUTH0_AUDIENCE=https://onit-api
VITE_AUTH0_SCOPE=openid profile email
# Must match Auth0 Allowed Callback URLs exactly (Provider + Tasker apps).
# Must match Auth0 Allowed Callback URLs — use /auth so redirect lands on login page
VITE_AUTH0_REDIRECT_URI=http://localhost:5173/auth

# AI features (OpenAI). If you need server-side calls, proxy them through the
# backend; do NOT ship a raw secret key in the bundle.
VITE_OPENAI_API_KEY=
VITE_MSG91_WIDGET_ID=
# Widget auth token from MSG91 dashboard (OTP widget → enable token auth). NOT the account authkey.
VITE_MSG91_WIDGET_TOKEN=
# Legacy alias — prefer VITE_MSG91_WIDGET_TOKEN
VITE_MSG91_AUTH_KEY=
