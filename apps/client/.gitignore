# Environment files — NEVER commit. Templates only.
# Broad rule covering every nesting level so a stray client/src/.env
# (like the one that leaked) can never be re-added.
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

*.local

